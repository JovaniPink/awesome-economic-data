  "purpose": "Establish conservative point-in-time availability cutoffs for final QCEW third-month-employment outcomes for 2019 through 2024 reference years.",
  "claimBoundary": {
    "admission": "This bundle supports a final-outcome timing admission only. A fold may use a selected QCEW outcome no earlier than the listed annual final-outcome availability event.",
    "doesNotEstablish": [
      "The byte-for-byte preliminary QCEW file that was available on any historical release date.",
      "That a current BLS download reproduces an earlier publication vintage.",
      "A source license, redistribution permission, attribution requirement, or modeling permission.",
      "A row-level completeness or positive-level audit for a particular model run."
    ],
    "cutoffPolicy": "Use the full-data availability time rather than the earlier County Employment and Wages news-release time. For each reference year, use the first-quarter full-data event in the following reference year as the conservative final-outcome cutoff."
  },
